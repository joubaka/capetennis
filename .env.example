APP_NAME="Cape Tennis"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
ASSET_URL=

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="info@capetennis.co.za"
MAIL_FROM_NAME="${APP_NAME}"

MAIL_NOREPLY1_HOST=
MAIL_NOREPLY1_PORT=587
MAIL_NOREPLY1_ENCRYPTION=tls
MAIL_NOREPLY1_USERNAME=noreply1@capetennis.co.za
MAIL_NOREPLY1_PASSWORD=

MAIL_NOREPLY2_HOST=
MAIL_NOREPLY2_PORT=587
MAIL_NOREPLY2_ENCRYPTION=tls
MAIL_NOREPLY2_USERNAME=noreply2@capetennis.co.za
MAIL_NOREPLY2_PASSWORD=

# Bulk Email Throttling
BULK_MAIL_DELAY_SECONDS=10
BULK_MAIL_MAX_PER_MINUTE=10
BULK_MAIL_BATCH_THRESHOLD=10
BULK_MAIL_MAX_TRIES=3

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_SANDBOX_ID=
PAYFAST_SANDBOX_KEY=
PAYFAST_SANDBOX=false
PAYFAST_PASSPHRASE=
PAYFAST_PASSPHRASE_LIVE=
PAYFAST_PASSPHRASE_SANDBOX=
PAYFAST_LIVE_URL=https://www.payfast.co.za/eng/process
PAYFAST_SANDBOX_URL=https://sandbox.payfast.co.za/eng/process
PAYFAST_LIVE_MERCHANT_ID=
PAYFAST_LIVE_MERCHANT_KEY=
PAYFAST_SANDBOX_MERCHANT_ID=
PAYFAST_SANDBOX_MERCHANT_KEY=
PAYFAST_NOTIFY_URL=/notify
PAYFAST_NOTIFY_TEAM_URL=/notify_team
PAYFAST_CANCEL_URL=/cancel
PAYFAST_RETURN_URL=/

DRAW_ENGINE_MISMATCH_THRESHOLD=5

# Canonical append-only audit trail
AUDIT_ENABLED=true
AUDIT_REQUIRE_TABLE=true
AUDIT_FAIL_CLOSED=true
AUDIT_PUBLIC_PAGE_VIEWS=true
AUDIT_MAX_STRING_LENGTH=2000
AUDIT_MAX_DEPTH=6
AUDIT_JOURNEY_RETENTION_DAYS=180
AUDIT_SECURITY_RETENTION_DAYS=730
AUDIT_BUSINESS_RETENTION_DAYS=2555
